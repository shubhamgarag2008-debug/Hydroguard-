  </div>

</section>

<footer>

  © 2026 HydroGuard • Intelligent Flood Early Warning System

</footer>

<script>

function toggleMenu(){

  document.getElementById("nav").classList.toggle("active");

}

function predictFlood(){

  const water =
    parseFloat(document.getElementById("water").value) || 0;

  const rain =
    parseFloat(document.getElementById("rain").value) || 0;

  const result =
    document.getElementById("result");

  let risk;
  let message;

  if(water >= 6 || rain >= 120){

    risk = "🔴 HIGH FLOOD RISK";

    message =
      "Warning: Conditions indicate a high-risk situation. Immediate monitoring and local emergency preparedness are recommended.";

  }

  else if(water >= 4 || rain >= 60){

    risk = "🟡 MODERATE FLOOD RISK";

    message =
      "Caution: Conditions are becoming concerning. Continue monitoring water levels and rainfall.";

  }

  else{

    risk = "🟢 LOW FLOOD RISK";

    message =
      "Current demo conditions indicate a relatively low flood risk.";

  }

  result.style.display = "block";

  result.innerHTML =
    "<strong>" + risk + "</strong><br><br>" + message;

}

</script>

