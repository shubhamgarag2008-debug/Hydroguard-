@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
@import 'tailwindcss';
@import 'tw-animate-css';
@plugin "@tailwindcss/typography";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>HydroGuard | Flood Early Warning System</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,Helvetica,sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#eef7fa;
  color:#102a43;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#073b5c;
  color:white;
  padding:14px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  box-shadow:0 3px 15px rgba(0,0,0,.2);
}

.logo{
  font-size:24px;
  font-weight:bold;
}

.logo span{
  color:#39d5e8;
}

nav{
  display:flex;
  gap:25px;
}

nav a{
  color:white;
  text-decoration:none;
  font-size:15px;
}

nav a:hover{
  color:#39d5e8;
}

.menu{
  display:none;
  font-size:26px;
  cursor:pointer;
}

.hero{
  min-height:650px;
  background:
  linear-gradient(rgba(3,48,75,.88),rgba(4,71,98,.9)),
  radial-gradient(circle at 80% 30%,#28b7d5,transparent 35%);
  color:white;
  display:flex;
  align-items:center;
  padding:60px 7%;
}

.hero-content{
  max-width:700px;
}

.badge{
  display:inline-block;
  background:#123f5d;
  border:1px solid #38d2e5;
  padding:8px 15px;
  border-radius:20px;
  color:#72e8f5;
  margin-bottom:20px;
  font-size:13px;
}

.hero h1{
  font-size:58px;
  line-height:1.05;
  margin-bottom:20px;
}

.hero h1 span{
  color:#39d5e8;
}

.hero p{
  font-size:18px;
  line-height:1.7;
  color:#d5eaf1;
  margin-bottom:30px;
}

.buttons{
  display:flex;
  gap:15px;
  flex-wrap:wrap;
}

.btn{
  padding:14px 23px;
  border-radius:8px;
  text-decoration:none;
  font-weight:bold;
  display:inline-block;
}

.primary{
  background:#ffc83d;
  color:#17324d;
}

.secondary{
  border:1px solid #9ddce7;
  color:white;
}

section{
  padding:70px 7%;
}

.section-title{
  text-align:center;
  margin-bottom:40px;
}

.section-title h2{
  font-size:35px;
  color:#073b5c;
}

.section-title p{
  margin-top:10px;
  color:#617d8d;
}

.dashboard{
  margin-top:-70px;
  position:relative;
}

.dashboard-card{
  background:white;
  border-radius:18px;
  padding:25px;
  box-shadow:0 10px 35px rgba(0,50,80,.15);
}

.status{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.safe{
  color:#168a52;
  font-weight:bold;
}

.live{
  color:#758b96;
  font-size:13px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.stat{
  padding:22px;
  background:#f4fafc;
  border-radius:12px;
  border:1px solid #dcecf1;
}

.stat h3{
  font-size:30px;
  color:#073b5c;
  margin:8px 0;
}

.stat p{
  color:#718795;
  font-size:13px;
}

.features{
  background:white;
}

.cards{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:25px;
}

.card{
  background:#f7fbfc;
  padding:28px;
  border-radius:15px;
  border:1px solid #dcecf1;
  transition:.25s;
}

.card:hover{
  transform:translateY(-5px);
  box-shadow:0 10px 25px rgba(0,70,100,.1);
}

.icon{
  width:48px;
  height:48px;
  border-radius:12px;
  background:#dff7fa;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  margin-bottom:18px;
}

.card h3{
  color:#073b5c;
  margin-bottom:10px;
}

.card p{
  color:#687f8c;
  line-height:1.6;
  font-size:14px;
}

.prediction{
  background:#eaf6f8;
}

.prediction-box{
  max-width:800px;
  margin:auto;
  background:white;
  padding:30px;
  border-radius:18px;
  box-shadow:0 8px 25px rgba(0,60,90,.12);
}

.form-group{
  margin-bottom:18px;
}

label{
  display:block;
  margin-bottom:7px;
  font-weight:bold;
  color:#294b5d;
}

select,input{
  width:100%;
  padding:13px;
  border:1px solid #c8dfe6;
  border-radius:8px;
  font-size:15px;
}

.predict-btn{
  width:100%;
  border:0;
  padding:14px;
  background:#087ea4;
  color:white;
  border-radius:8px;
  font-weight:bold;
  font-size:16px;
  cursor:pointer;
}

.result{
  display:none;
  margin-top:25px;
  padding:20px;
  border-radius:12px;
  background:#fff5d9;
  border-left:5px solid #ffc83d;
}

.districts{
  background:white;
}

.district-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

.district{
  padding:20px;
  border-radius:12px;
  background:#f5fafc;
  border:1px solid #dcecf1;
  cursor:pointer;
  transition:.2s;
}

.district:hover{
  background:#e4f7fa;
  transform:translateY(-3px);
}

.district strong{
  display:block;
  color:#073b5c;
  margin-bottom:7px;
}

.district small{
  color:#718795;
}

.about{
  background:#073b5c;
  color:white;
}

.about-content{
  max-width:900px;
  margin:auto;
  text-align:center;
}

.about h2{
  font-size:36px;
  margin-bottom:20px;
}

.about p{
  line-height:1.8;
  color:#d7e9ef;
}

footer{
  background:#04283e;
  color:#b8d0d9;
  text-align:center;
  padding:25px;
  font-size:13px;
}

@media(max-width:800px){

  nav{
    display:none;
    position:absolute;
    top:65px;
    left:0;
    width:100%;
    background:#073b5c;
    flex-direction:column;
    padding:20px 7%;
  }

  nav.active{
    display:flex;
  }

  .menu{
    display:block;
  }

  .hero{
    min-height:600px;
    padding:50px 6%;
  }

  .hero h1{
    font-size:43px;
  }

  .hero p{
    font-size:16px;
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .cards{
    grid-template-columns:1fr;
  }

  .district-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:450px){

  .stats{
    grid-template-columns:1fr;
  }

  .district-grid{
    grid-template-columns:1fr;
  }

  .hero h1{
    font-size:38px;
  }

  section{
    padding:55px 5%;
  }
}
</style>
</head>

<body>

