@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
@import 'tailwindcss';
@import 'tw-animate-css';
@plugin "@tailwindcss/typography";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --font-sans: var(--app-font-sans);
  --font-mono: var(--app-font-mono);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --background: 195 38% 96%;
  --foreground: 209 42% 16%;
  --border: 195 20% 84%;
  --input: 195 20% 84%;
  --ring: 187 78% 40%;
  --card: 0 0% 100%;
  --card-foreground: 209 42% 16%;
  --card-border: 195 22% 88%;
  --primary: 187 78% 36%;
  --primary-foreground: 0 0% 100%;
  --secondary: 211 48% 17%;
  --secondary-foreground: 0 0% 100%;
  --muted: 195 25% 91%;
  --muted-foreground: 207 18% 43%;
  --accent: 41 92% 62%;
  --accent-foreground: 209 42% 16%;
  --destructive: 4 72% 53%;
  --destructive-foreground: 0 0% 100%;
  --sidebar: 211 48% 17%;
  --sidebar-foreground: 0 0% 100%;
  --sidebar-border: 211 38% 28%;
  --sidebar-primary: 187 78% 45%;
  --sidebar-primary-foreground: 209 42% 16%;
  --sidebar-accent: 211 40% 25%;
  --sidebar-accent-foreground: 0 0% 100%;
  --app-font-sans: 'Manrope', ui-sans-serif, sans-serif;
  --app-font-mono: 'DM Mono', ui-monospace, monospace;
  --radius: 1rem;
  --shadow-card: 0 18px 45px hsl(211 45% 20% / 0.08);
  --shadow-deep: 0 22px 60px hsl(211 48% 10% / 0.2);
}

.dark {
  --background: 211 48% 11%;
  --foreground: 195 38% 96%;
  --border: 211 28% 25%;
  --input: 211 28% 25%;
  --card: 211 41% 16%;
  --card-foreground: 195 38% 96%;
  --card-border: 211 28% 25%;
  --primary: 187 78% 48%;
  --primary-foreground: 211 48% 11%;
  --secondary: 195 26% 23%;
  --secondary-foreground: 195 38% 96%;
  --muted: 211 28% 21%;
  --muted-foreground: 195 18% 68%;
  --accent: 41 92% 62%;
  --accent-foreground: 211 48% 11%;
}

@layer base {
  * {
    @apply border-border;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    @apply font-sans antialiased bg-background text-foreground;
    margin: 0;
    min-width: 320px;
  }

  button,
  a,
  select {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  select:focus-visible {
    outline: 3px solid hsl(var(--accent));
    outline-offset: 3px;
  }
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes drift {
  from { transform: translateX(0); }
  to { transform: translateX(18px); }
}

@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.65; }
  50% { transform: scale(1.15); opacity: 1; }
}

.hydro-page {
  overflow: hidden;
  background:
    radial-gradient(circle at 15% 4%, hsl(187 58% 91% / 0.7), transparent 25rem),
    hsl(var(--background));
}

.hydro-page::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.035;
  z-index: 20;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  border-bottom: 1px solid hsl(195 30% 100% / 0.12);
  background: hsl(211 48% 17% / 0.94);
  color: hsl(0 0% 100%);
  backdrop-filter: blur(18px);
}

.header-inner {
  width: min(1180px, calc(100% - 40px));
  min-height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  color: white;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.08rem;
  font-weight: 800;
  letter-spacing: -0.045em;
  text-decoration: none;
}

.brand-mark {
  width: 33px;
  height: 33px;
  border-radius: 10px 10px 10px 3px;
  display: grid;
  place-items: center;
  color: hsl(211 48% 17%);
  background: hsl(var(--accent));
  transform: rotate(-7deg);
}

.brand-mark svg { transform: rotate(7deg); }
.brand-accent { color: hsl(187 79% 63%); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 5px;
}

.nav-link {
  position: relative;
  padding: 10px 14px;
  color: hsl(195 22% 83%);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-decoration: none;
  transition: color 180ms ease, transform 180ms ease;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 3px;
  left: 14px;
  right: 14px;
  height: 2px;
  border-radius: 4px;
  background: hsl(var(--accent));
  opacity: 0;
  transform: scaleX(0.4);
  transition: opacity 180ms ease, transform 180ms ease;
}

.nav-link:hover { color: white; transform: translateY(-1px); }
.nav-link:hover::after { opacity: 1; transform: scaleX(1); }

.menu-button {
  display: none;
  border: 1px solid hsl(0 0% 100% / 0.2);
  background: hsl(0 0% 100% / 0.08);
  color: white;
  border-radius: 10px;
  padding: 9px;
}

.hero {
  position: relative;
  isolation: isolate;
  color: white;
  background:
    radial-gradient(circle at 82% 12%, hsl(187 80% 49% / 0.28), transparent 24rem),
    linear-gradient(118deg, hsl(211 48% 17%) 0%, hsl(211 54% 21%) 54%, hsl(193 58% 26%) 100%);
}

.hero::after {
  content: '';
  position: absolute;
  z-index: -1;
  width: 48vw;
  height: 22rem;
  right: -13vw;
  bottom: -9rem;
  border: 1px solid hsl(187 80% 70% / 0.15);
  border-radius: 50%;
  box-shadow: 0 0 0 22px hsl(187 80% 70% / 0.04), 0 0 0 44px hsl(187 80% 70% / 0.03);
  transform: rotate(-9deg);
}

.hero-inner {
  width: min(1180px, calc(100% - 40px));
  min-height: 620px;
  margin: 0 auto;
  padding: 85px 0 105px;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
  align-items: center;
  gap: clamp(44px, 7vw, 100px);
}

.eyebrow,
.section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: hsl(187 79% 70%);
  font-family: var(--app-font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.eyebrow::before,
.section-eyebrow::before {
  content: '';
  width: 25px;
  height: 1px;
  background: currentColor;
}

.hero-copy { animation: rise-in 700ms ease both; }
.hero-title {
  max-width: 690px;
  margin: 22px 0 20px;
  font-size: clamp(3rem, 6.2vw, 5.45rem);
  font-weight: 800;
  line-height: 0.98;
  letter-spacing: -0.075em;
}

.hero-title em {
  color: hsl(187 79% 70%);
  font-style: normal;
}

.hero-description {
  max-width: 570px;
  color: hsl(195 27% 81%);
  font-size: clamp(0.98rem, 1.5vw, 1.12rem);
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 32px;
}

.button-primary,
.button-secondary {
  min-height: 48px;
  border-radius: 10px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  font: 700 0.78rem var(--app-font-sans);
  cursor: pointer;
  transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
}

.button-primary {
  border: 1px solid hsl(var(--accent));
  color: hsl(var(--accent-foreground));
  background: hsl(var(--accent));
  box-shadow: 0 9px 24px hsl(41 92% 45% / 0.18);
}

.button-primary:hover { background: hsl(41 92% 69%); transform: translateY(-2px); }
.button-primary:active, .button-secondary:active { transform: translateY(0); }

.button-secondary {
  border: 1px solid hsl(0 0% 100% / 0.28);
  color: white;
  background: hsl(0 0% 100% / 0.05);
}

.button-secondary:hover { border-color: hsl(187 79% 70% / 0.7); background: hsl(187 79% 70% / 0.11); transform: translateY(-2px); }

.hero-meta {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 44px;
  color: hsl(195 22% 69%);
  font: 0.67rem var(--app-font-mono);
}

.meta-divider { width: 1px; height: 20px; background: hsl(0 0% 100% / 0.2); }

.telemetry-card {
  position: relative;
  overflow: hidden;
  min-height: 360px;
  padding: 28px;
  border: 1px solid hsl(0 0% 100% / 0.3);
  border-radius: 20px;
  background: linear-gradient(145deg, hsl(0 0% 100% / 0.98), hsl(193 50% 94% / 0.96));
  color: hsl(var(--foreground));
  box-shadow: var(--shadow-deep);
  animation: rise-in 800ms 120ms ease both;
}

.telemetry-card::before {
  content: '';
  position: absolute;
  width: 180px;
  height: 180px;
  top: -85px;
  right: -35px;
  border-radius: 50%;
  border: 1px solid hsl(187 78% 36% / 0.14);
  box-shadow: 0 0 0 20px hsl(187 78% 36% / 0.04), 0 0 0 40px hsl(187 78% 36% / 0.03);
}

.telemetry-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.live-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: hsl(159 53% 34%);
  font: 700 0.67rem var(--app-font-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: hsl(159 60% 43%);
  box-shadow: 0 0 0 5px hsl(159 60% 43% / 0.13);
  animation: breathe 2.2s ease-in-out infinite;
}

.telemetry-code {
  color: hsl(207 18% 51%);
  font: 0.65rem var(--app-font-mono);
}

.telemetry-rule {
  height: 1px;
  margin: 25px 0 25px;
  background: hsl(195 20% 84%);
}

.telemetry-label {
  color: hsl(207 18% 51%);
  font-size: 0.73rem;
  font-weight: 700;
}

.water-reading {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin: 7px 0 22px;
}

.water-reading strong {
  color: hsl(211 48% 17%);
  font: 800 clamp(3.5rem, 6vw, 4.5rem)/1 var(--app-font-sans);
  letter-spacing: -0.09em;
}

.water-reading span {
  color: hsl(187 78% 36%);
  font: 700 1.15rem var(--app-font-mono);
}

.telemetry-location {
  display: flex;
  align-items: center;
  gap: 9px;
  color: hsl(207 18% 37%);
  font-size: 0.82rem;
}

.telemetry-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 32px;
}

.telemetry-detail {
  padding: 13px 14px;
  border: 1px solid hsl(195 24% 86%);
  border-radius: 11px;
  background: hsl(0 0% 100% / 0.55);
}

.telemetry-detail span {
  display: block;
  color: hsl(207 18% 51%);
  font: 0.62rem var(--app-font-mono);
  text-transform: uppercase;
}

.telemetry-detail strong {
  display: block;
  margin-top: 6px;
  color: hsl(211 48% 17%);
  font-size: 0.82rem;
}

.section {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  padding: 105px 0;
}

.section-heading {
  max-width: 620px;
  margin-bottom: 44px;
}

.section-heading.centered {
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

.section-heading.centered .section-eyebrow { justify-content: center; }

.section-title {
  margin: 15px 0 13px;
  color: hsl(211 48% 17%);
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.05;
  letter-spacing: -0.07em;
}

.section-copy {
  color: hsl(var(--muted-foreground));
  font-size: 0.95rem;
  line-height: 1.75;
}

.about-section {
  position: relative;
}

.feature-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.45fr;
  gap: clamp(28px, 6vw, 90px);
  align-items: start;
}

.feature-intro {
  position: sticky;
  top: 110px;
}

.feature-intro .section-heading { margin-bottom: 24px; }

.feature-index {
  display: flex;
  align-items: center;
  gap: 10px;
  color: hsl(207 18% 51%);
  font: 0.64rem var(--app-font-mono);
}

.feature-index::before {
  content: '';
  width: 38px;
  height: 1px;
  background: hsl(187 78% 36%);
}

.feature-list { display: grid; gap: 14px; }

.feature-card {
  display: grid;
  grid-template-columns: 58px 1fr;
  gap: 18px;
  align-items: start;
  padding: 24px 25px;
  border: 1px solid hsl(var(--card-border));
  border-radius: 15px;
  background: hsl(var(--card));
  box-shadow: var(--shadow-card);
  transition: transform 220ms ease, border-color 220ms ease;
}

.feature-card:hover { transform: translateX(5px); border-color: hsl(187 78% 36% / 0.45); }

.feature-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  color: hsl(187 78% 36%);
  background: hsl(187 78% 36% / 0.1);
}

.feature-card:nth-child(2) .feature-icon { color: hsl(211 60% 43%); background: hsl(211 60% 43% / 0.1); }
.feature-card:nth-child(3) .feature-icon { color: hsl(34 76% 45%); background: hsl(34 76% 45% / 0.12); }

.feature-card h3 {
  margin: 1px 0 8px;
  color: hsl(211 48% 17%);
  font-size: 0.96rem;
  letter-spacing: -0.02em;
}

.feature-card p {
  color: hsl(var(--muted-foreground));
  font-size: 0.82rem;
  line-height: 1.65;
}

.dashboard-band {
  background: hsl(193 50% 92% / 0.62);
  border-top: 1px solid hsl(195 30% 86%);
  border-bottom: 1px solid hsl(195 30% 86%);
}

.dashboard-band .section { padding-top: 92px; padding-bottom: 100px; }

.dashboard-heading-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 35px;
}

.dashboard-heading-row .section-heading { margin: 0; }

.station-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 13px;
  border: 1px solid hsl(187 78% 36% / 0.2);
  border-radius: 30px;
  color: hsl(187 78% 30%);
  background: hsl(0 0% 100% / 0.58);
  font: 0.64rem var(--app-font-mono);
}

.station-pill svg { color: hsl(159 60% 43%); }

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr;
  gap: 15px;
}

.data-card {
  min-height: 204px;
  position: relative;
  overflow: hidden;
  padding: 24px;
  border: 1px solid hsl(0 0% 100% / 0.8);
  border-radius: 16px;
  background: hsl(0 0% 100% / 0.83);
  box-shadow: 0 11px 32px hsl(211 45% 20% / 0.06);
}

.data-card.primary-data {
  color: white;
  background: hsl(211 48% 17%);
  box-shadow: 0 15px 36px hsl(211 48% 17% / 0.18);
}

.data-card::after {
  content: '';
  position: absolute;
  width: 145px;
  height: 145px;
  right: -60px;
  bottom: -72px;
  border: 1px solid hsl(187 78% 36% / 0.14);
  border-radius: 50%;
  box-shadow: 0 0 0 18px hsl(187 78% 36% / 0.04);
}

.data-card-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: hsl(var(--muted-foreground));
  font: 0.68rem var(--app-font-mono);
  text-transform: uppercase;
}

.primary-data .data-card-label { color: hsl(195 25% 74%); }

.data-value {
  margin-top: 16px;
  color: hsl(211 48% 17%);
  font-size: clamp(2.2rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.08em;
}

.primary-data .data-value { color: hsl(187 79% 70%); }
.data-unit { color: hsl(187 78% 36%); font: 700 0.85rem var(--app-font-mono); letter-spacing: 0; }
.primary-data .data-unit { color: hsl(187 79% 70%); }

.data-foot {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 22px;
  color: hsl(var(--muted-foreground));
  font-size: 0.68rem;
}

.primary-data .data-foot { color: hsl(195 25% 74%); }
.risk-low { color: hsl(159 53% 34%); }

.prediction-section {
  background:
    radial-gradient(circle at 88% 58%, hsl(41 92% 62% / 0.11), transparent 18rem),
    hsl(var(--background));
}

.prediction-shell {
  display: grid;
  grid-template-columns: 0.72fr 1.28fr;
  gap: clamp(25px, 6vw, 85px);
  align-items: center;
}

.prediction-intro .section-title { max-width: 380px; }
.prediction-intro .section-copy { max-width: 410px; }

.prediction-form {
  padding: 30px;
  border: 1px solid hsl(var(--card-border));
  border-radius: 18px;
  background: hsl(var(--card));
  box-shadow: var(--shadow-card);
}

.form-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 26px;
}

.form-title {
  margin: 0;
  color: hsl(211 48% 17%);
  font-size: 1rem;
  letter-spacing: -0.03em;
}

.form-status {
  color: hsl(207 18% 51%);
  font: 0.61rem var(--app-font-mono);
}

.form-label {
  display: block;
  margin-bottom: 9px;
  color: hsl(211 48% 17%);
  font-size: 0.76rem;
  font-weight: 800;
}

.select-wrap { position: relative; }
.select-wrap svg {
  position: absolute;
  top: 50%;
  right: 14px;
  pointer-events: none;
  color: hsl(187 78% 36%);
  transform: translateY(-50%);
}

.location-select {
  width: 100%;
  min-height: 50px;
  appearance: none;
  padding: 0 42px 0 14px;
  border: 1px solid hsl(195 20% 82%);
  border-radius: 10px;
  outline: none;
  color: hsl(211 48% 17%);
  background: hsl(195 38% 97%);
  font: 600 0.8rem var(--app-font-sans);
  cursor: pointer;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.location-select:hover { border-color: hsl(187 78% 36% / 0.55); }
.location-select:focus { border-color: hsl(187 78% 36%); box-shadow: 0 0 0 4px hsl(187 78% 36% / 0.12); }

.analyze-button { width: 100%; margin-top: 16px; }

.result-panel {
  display: grid;
  grid-template-columns: 45px 1fr;
  align-items: start;
  gap: 14px;
  margin-top: 20px;
  padding: 17px;
  border: 1px solid hsl(159 43% 75%);
  border-radius: 12px;
  color: hsl(159 53% 27%);
  background: hsl(159 60% 95%);
  animation: rise-in 300ms ease both;
}

.result-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: hsl(159 53% 34%);
  background: hsl(159 60% 86%);
}

.result-panel h3 { margin: 1px 0 4px; font-size: 0.8rem; }
.result-panel p { margin: 0; font-size: 0.74rem; line-height: 1.6; }

.site-footer {
  padding: 55px 20px 35px;
  color: hsl(195 22% 76%);
  background: hsl(211 48% 17%);
}

.footer-inner {
  width: min(1180px, 100%);
  margin: 0 auto;
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 30px;
}

.footer-brand { margin-bottom: 12px; }
.footer-description { max-width: 310px; color: hsl(195 22% 65%); font-size: 0.75rem; line-height: 1.7; }
.footer-note { text-align: right; color: hsl(195 22% 65%); font: 0.65rem var(--app-font-mono); line-height: 1.8; }
.footer-bottom {
  width: min(1180px, 100%);
  margin: 45px auto 0;
  padding-top: 17px;
