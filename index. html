@layer base {
  * {
    @apply border-border;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    @apply font-sans antialiased bg-background text-foreground;
    margin: 0;
    min-width: 320px;
  }

  button,
  a,
  select {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  select:focus-visible {
    outline: 3px solid hsl(var(--accent));
    outline-offset: 3px;
  }
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes drift {
  from { transform: translateX(0); }
  to { transform: translateX(18px); }
}

@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.65; }
  50% { transform: scale(1.15); opacity: 1; }
}

.hydro-page {
  overflow: hidden;
  background:
    radial-gradient(circle at 15% 4%, hsl(187 58% 91% / 0.7), transparent 25rem),
    hsl(var(--background));
}

.hydro-page::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.035;
  z-index: 20;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  border-bottom: 1px solid hsl(195 30% 100% / 0.12);
  background: hsl(211 48% 17% / 0.94);
  color: hsl(0 0% 100%);
  backdrop-filter: blur(18px);
}

.header-inner {
  width: min(1180px, calc(100% - 40px));
  min-height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  color: white;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.08rem;
  font-weight: 800;
  letter-spacing: -0.045em;
  text-decoration: none;
}

.brand-mark {
  width: 33px;
  height: 33px;
  border-radius: 10px 10px 10px 3px;
  display: grid;
  place-items: center;
  color: hsl(211 48% 17%);
  background: hsl(var(--accent));
  transform: rotate(-7deg);
}

.brand-mark svg { transform: rotate(7deg); }
.brand-accent { color: hsl(187 79% 63%); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 5px;
}

.nav-link {
  position: relative;
  padding: 10px 14px;
  color: hsl(195 22% 83%);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-decoration: none;
  transition: color 180ms ease, transform 180ms ease;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 3px;
  left: 14px;
  right: 14px;
  height: 2px;
  border-radius: 4px;
  background: hsl(var(--accent));
  opacity: 0;
  transform: scaleX(0.4);
  transition: opacity 180ms ease, transform 180ms ease;
}

.nav-link:hover { color: white; transform: translateY(-1px); }
.nav-link:hover::after { opacity: 1; transform: scaleX(1); }

.menu-button {
  display: none;
  border: 1px solid hsl(0 0% 100% / 0.2);
  background: hsl(0 0% 100% / 0.08);
  color: white;
  border-radius: 10px;
  padding: 9px;
}

.hero {
  position: relative;
  isolation: isolate;
  color: white;
  background:
    radial-gradient(circle at 82% 12%, hsl(187 80% 49% / 0.28), transparent 24rem),
    linear-gradient(118deg, hsl(211 48% 17%) 0%, hsl(211 54% 21%) 54%, hsl(193 58% 26%) 100%);
}

.hero::after {
  content: '';
  position: absolute;
  z-index: -1;
  width: 48vw;
  height: 22rem;
  right: -13vw;
  bottom: -9rem;
  border: 1px solid hsl(187 80% 70% / 0.15);
  border-radius: 50%;
  box-shadow: 0 0 0 22px hsl(187 80% 70% / 0.04), 0 0 0 44px hsl(187 80% 70% / 0.03);
  transform: rotate(-9deg);
}

.hero-inner {
  width: min(1180px, calc(100% - 40px));
  min-height: 620px;
  margin: 0 auto;
  padding: 85px 0 105px;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
  align-items: center;
  gap: clamp(44px, 7vw, 100px);
}

.eyebrow,
.section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: hsl(187 79% 70%);
  font-family: var(--app-font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.eyebrow::before,
.section-eyebrow::before {
